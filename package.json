{
  "name": "teen_process",
  "version": "5.0.0",
  "description": "A grown up version of Node's spawn/exec",
  "keywords": [
    "child",
    "child_process",
    "exec",
    "process",
    "process management",
    "spawn",
    "subprocess"
  ],
  "bugs": {
    "url": "https://github.com/appium/node-teen_process/issues"
  },
  "license": "Apache-2.0",
  "author": "Appium Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/appium/node-teen_process.git"
  },
  "bin": {},
  "directories": {
    "lib": "lib"
  },
  "files": [
    "lib",
    "build/lib",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./build/lib/index.js",
  "types": "./build/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/lib/index.d.ts",
      "default": "./build/lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('node:fs').rmSync('build', {recursive: true, force: true})\"",
    "dev": "npm run build -- --watch",
    "lint": "oxlint -c oxlint.config.mjs .",
    "lint:fix": "oxlint -c oxlint.config.mjs --fix .",
    "lint:types": "tsc",
    "format": "oxfmt -c oxfmt.config.mjs .",
    "format:check": "oxfmt -c oxfmt.config.mjs --check .",
    "prepare": "npm run rebuild",
    "rebuild": "npm run clean && npm run build",
    "test": "node --test --enable-source-maps --test-timeout=60000 \"./build/test/**/*.spec.js\""
  },
  "dependencies": {
    "shell-quote": "^1.12.0"
  },
  "devDependencies": {
    "@appium/oxc-config": "^2.0.0-beta.2",
    "@appium/semantic-release-config": "^2.0.0-beta.1",
    "@appium/tsconfig": "^2.0.0-beta.1",
    "@appium/types": "^2.0.0-beta.5",
    "@types/node": "^26.0.0",
    "@types/shell-quote": "^1.7.5"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=10"
  }
}
